[Unit]
Description=Insomnia Keep-Awake Tray Application
Documentation=https://github.com/VivatVibe/Insomnia_linux
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/insomnia run
Restart=on-failure
RestartSec=5s
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
